# Copy to .env and fill in. Never commit .env.

PORT=4000
# Local Postgres. Production: a UK-region database (Technical Architecture).
DATABASE_URL=postgres://oa:oa@localhost:5432/offshoreassure

# Long random strings (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
CODE_SECRET=change-me-too
SESSION_HOURS=8

# Where the React app runs (comma-separated for several)
FRONTEND_ORIGIN=http://localhost:5173
# Same site (Vite proxy / same domain): lax. Frontend and API on different domains: none + COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Verification code rules (pending confirmation; same as ScotWarm)
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# Pending decision: admin approval after email verification
REQUIRE_ADMIN_APPROVAL=false

# Email (SMTP). Leave SMTP_HOST empty in development: codes are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OffshoreAssure <no-reply@yourdomain.com>"

# Development/demo only: also show the code in the popup (ignored in production)
DEV_SHOW_CODES=false

# Stored documents are encrypted (AES-256-GCM). Production: 64 hex characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=

# Admin account for: npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
